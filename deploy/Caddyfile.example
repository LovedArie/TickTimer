# TickTimer behind Caddy — the whole reverse-proxy config.
#
# THE RULE THIS ENCODES: Caddy is the only thing that talks to TickTimer.
# ticktimer-server binds 127.0.0.1 (its default since v30.2.1) and never sees
# a request Caddy has not already parsed and validated. That is what makes a
# small hand-rolled HTTP parser safe to run on a box with a public address.
#
# Copy to /etc/caddy/Caddyfile, change the name, then:
#   systemctl reload caddy

ticktimer.example.com {
	# ---- downloads: the APK, and later the WebAssembly build --------------
	#
	# Handled BEFORE the proxy, and deliberately NOT by ticktimer-server.
	# Serving files means parsing paths, and a hand-rolled parser that
	# mishandles "../" hands out the whole disk. Caddy has solved static
	# files properly for years; the right move is to not write that code at
	# all. The server never sees these requests.
	#
	# Put the signed APK in /var/www/ticktimer/ and handing the app to a
	# friend becomes a URL:
	#     https://ticktimer.example.com/download/ticktimer.apk
	handle_path /download/* {
		root * /var/www/ticktimer
		file_server browse
	}

	# ---- the web app (v30.4) ---------------------------------------------
	#
	# The WebAssembly build, served from the SAME ORIGIN as the API below.
	# That is not a convenience: same-origin means the app's calls to /login
	# and /planner are not cross-origin at all, so the whole CORS question
	# mostly evaporates. (The preflight support added in v30.2.1 still earns
	# its keep — a browser preflights on the HEADERS, and every call here
	# sends Content-Type: application/json or an Authorization token.)
	#
	# Copy the contents of build-wasm/serve/ into /var/www/ticktimer-app/.
	#
	# AND THEN FIX THE MODES. Caddy runs as its own unprivileged user, so a
	# directory it cannot traverse is a 403 — not a 404, which is the tell.
	# `scp -r` reproduces the sending machine's modes, and one that arrives
	# as 700 root-only silently breaks everything under it. That happened to
	# icons/ and every app icon was unreachable for ten days, which would
	# have surfaced on someone's phone as "Add to Home Screen gives a blank
	# icon" — an iOS-shaped symptom with no iOS in it. After every copy:
	#
	#   find /var/www/ticktimer-app -type d -exec chmod 755 {} +
	#   find /var/www/ticktimer-app -type f -exec chmod 644 {} +
	handle /app* {
		root * /var/www/ticktimer-app
		uri strip_prefix /app

		# The .wasm is ~23 MB raw and ~8.1-8.5 MB compressed, so compression is the
		# difference between a pleasant first load on a phone and an
		# abandoned one. Caddy picks zstd or gzip per request.
		#
		# THE MATCH BLOCK IS NOT DECORATION, and leaving it out cost ten days
		# of serving 24 MB to phones. `encode zstd gzip` on its own compresses
		# only Caddy's DEFAULT content types, and `application/wasm` is not
		# among them in 2.6.x — so the two small text files were compressed
		# and the one enormous file that dominates the download was not.
		# Nothing warns: the response is a perfectly valid 200, just three
		# times the size the docs promise. Measured, 2026-08-31.
		#
		# Naming `match` REPLACES the default list rather than adding to it,
		# so the defaults worth keeping are repeated here. Check a deploy with
		#   curl -sI -H "Accept-Encoding: gzip" .../app/ticktimer.wasm
		# and look for Content-Encoding. A config that says `encode` is not
		# evidence that anything was encoded.
		encode zstd gzip {
			match {
				header Content-Type text/*
				header Content-Type application/json*
				header Content-Type application/javascript*
				header Content-Type application/xhtml+xml*
				header Content-Type image/svg+xml*
				header Content-Type application/wasm*
				header Content-Type application/manifest+json*
			}
		}

		# CACHED BUT REVALIDATED, deliberately not "immutable".
		#
		# These filenames never change between builds. Marking a fixed name
		# immutable for a year means a new build is never fetched, and no
		# amount of reloading fixes it — the phone would keep running last
		# month's app while its owner insisted they had updated. "no-cache"
		# is a misleading name: it does not mean don't store, it means ask
		# first. The browser keeps the ~8 MB and gets a 304 when nothing
		# changed, which costs one small round trip and is always correct.
		#
		# Content-addressed filenames would let us use immutable properly.
		# That is a build-pipeline change, and not one to make before anyone
		# has felt the round trip.
		#
		# THE PATHS BELOW INCLUDE /app ON PURPOSE, and this is the subtle one.
		# Caddy sorts directives into a fixed order that is NOT the order they
		# are written in, and `header` runs BEFORE `uri`. So when these
		# matchers are tested the path has not been stripped yet: it is still
		# /app/ticktimer.wasm. Written as /ticktimer.wasm they match nothing,
		# fire never, and emit no Cache-Control at all — which is exactly what
		# they did from August until 2026-08-31, silently. ETag still forced
		# revalidation, so nothing looked broken; the stated intent simply was
		# not in effect.
		#
		# The general lesson, worth more than the fix: in a Caddyfile the
		# written order is not the executed order, so any matcher that depends
		# on a rewrite has to know whether it runs before or after it. VERIFY
		# HEADERS AGAINST THE LIVE RESPONSE, never against the config.
		header /app/ticktimer.wasm       Cache-Control "no-cache"
		header /app/ticktimer.js         Cache-Control "no-cache"
		header /app/index.html           Cache-Control "no-cache"
		header /app/                     Cache-Control "no-cache"
		header /app/manifest.webmanifest Cache-Control "no-cache"
		# Icons genuinely do not change, and are small enough that being
		# wrong about one for a month costs nothing.
		header /app/icons/*              Cache-Control "public, max-age=2592000"

		file_server
	}

	# TLS is automatic: Caddy obtains and renews a Let's Encrypt certificate
	# for the name above. Nothing to configure and nothing to remember —
	# which matters, because the WebAssembly client will REQUIRE https (a
	# page served over TLS cannot call a plain-http backend), and because
	# Android refuses plain-http downloads from a browser by default.
	reverse_proxy 127.0.0.1:8080

	# reverse_proxy sets X-Forwarded-For for you. The server honours it only
	# from a loopback peer — i.e. from this proxy — which is what lets its
	# login brake count real clients instead of counting Caddy as one very
	# unlucky user.
}

# NOT configured here: rate limiting. Stock Caddy has no rate_limit directive
# (it needs a plugin and a custom build via xcaddy), so the login brake lives
# in the server instead — see docs/SERVER.md. Making the safe deployment
# depend on compiling your own web server is how the safe deployment does not
# happen.
