# Build output — every generator, every kit.
build*/
cmake-build-*/
*_autogen/

# Deployment artifacts (deploy-windows.bat / Inno output).
dist/
installer/Output/

# Shipped build archives. These are RELEASE ASSETS — they belong on the
# GitHub Releases shelf (docs/GITHUB.md), never in git history: two of them
# are 63 MB each, they are under GitHub's 100 MB per-file limit so nothing
# would refuse the push, and history is forever. GITHUB.md's release routine
# says `git add .`, which is exactly the command this line defends against.
# (Version/TickTimer.zip was committed before this rule existed. An ignore
# rule never untracks an already-tracked file; to drop it from future
# commits without deleting it from disk:  git rm --cached Version/TickTimer.zip)
Version/

# Editor and OS noise.
.vscode/
.idea/
.qtcreator/
*.user
.DS_Store
Thumbs.db

# Generated by tools/run-tests.bat on every run — churns constantly, and
# the log to SEND is the one on disk, not one from last week's history.
test-results.txt

# Personal working notes for Claude Code. CLAUDE.md IS shared (it documents
# the project); CLAUDE.local.md is the private half and stays out.
CLAUDE.local.md
