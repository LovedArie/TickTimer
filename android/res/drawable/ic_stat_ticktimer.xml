<?xml version="1.0" encoding="utf-8"?>
<!--
    The status-bar icon for TickTimer's notifications (v30.6).

    WHY THIS FILE EXISTS AT ALL: Notification.Builder.setSmallIcon is not
    optional. Posting without a valid one throws IllegalArgumentException
    ("Invalid notification (no valid small icon)") and takes the whole
    receiver process down with it. The first build used
    getApplicationInfo().icon, on the theory that the launcher icon is
    always there — it is not. Qt drops the icon attribute from the manifest
    when no app icon is configured, so that call returned 0 and every alarm
    crashed on arrival, with the notification never appearing.

    WHY A WHITE SILHOUETTE: Android does not draw this as a picture. It
    takes the alpha channel and tints it to match the system theme, so any
    colour here is thrown away and anything without transparency becomes a
    solid block. Hence one path, opaque white, on a transparent field.

    The shape is a clock face reading roughly 12:15 — the same idea as the
    painted tray icon on the desktop (a disc with hands), reduced to what
    survives at 24dp in a status bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.99,2C6.47,2 2,6.48 2,12s4.47,10 9.99,10C17.52,22 22,17.52 22,12S17.52,2 11.99,2zM12,20c-4.42,0 -8,-3.58 -8,-8s3.58,-8 8,-8 8,3.58 8,8 -3.58,8 -8,8z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12.5,7L11,7v6l5.25,3.15 0.75,-1.23 -4.5,-2.67z" />
</vector>
