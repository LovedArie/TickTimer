flowchart LR
    AD[("AppData<br/><i>events: date + start minutes</i>")]

    SVC["BlockAlarmService  (domain)<br/><i>high-water mark, born at 'now'<br/>grace window: 120 s<br/>Qt::PreciseTimer single-shot,<br/>nap capped at 1 h</i>"]

    MW["MainWindow toast client<br/><i>pref read at fire time ·<br/>titles resolved fresh by id ·<br/>mutes blocks already tracking ·<br/>same tray icon as the Pomodoro</i>"]

